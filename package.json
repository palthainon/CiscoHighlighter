{
  "name": "CiscoHighlighter",
  "displayName": "Cisco IOS Highlighter — Lawson Cyber LLC",
  "description": "Cisco configuration syntax highlighting and duplicate sequence diagnostics from Lawson Cyber LLC.",
  "version": "1.0.6",
  "publisher": "DerickL",
  "icon": "images/logo.png",
  "galleryBanner": {
    "color": "#3a2414",
    "theme": "dark"
  },
  "galleryImages": [
    "images/highlight-preview.png"
  ],
  "preview": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.102.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.122",
    "@types/vscode": "^1.102.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palthainon/CiscoHighlighter"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cisco"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cisco",
        "aliases": [
          "Cisco",
          "cisco"
        ],
        "extensions": [
          ".ios",
          ".cisco"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cisco",
        "scopeName": "text.cisco",
        "path": "./syntaxes/cisco.tmLanguage"
      }
    ]
  },
  "author": {
    "name": "Lawson Cyber LLC",
    "url": "https://lawsoncyber.com"
  },
  "homepage": "https://lawsoncyber.com"
}
